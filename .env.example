PORT=5000
ALLOWED_ORIGINS=https://multicam-frontend.vercel.app,http://localhost:3000

# Auth
# JWT signing secret — REQUIRED in production (insecure dev fallback + boot warning if unset)
# JWT_SECRET=change-me-long-random-string
# SQLite user DB location (dir is created automatically; gitignored)
DB_PATH=./data/users.db

# Rooms
# HMAC secret for signing/verifying room codes. Falls back to JWT_SECRET when
# unset, so setting JWT_SECRET alone secures both sessions and rooms. Set this
# only if you want room codes signed with a different secret than sessions.
# ROOM_SECRET=change-me-long-random-string
# Invite code lifetime in hours (default 24). The expiry is baked into the
# signed code, so changing this only affects newly minted codes.
# ROOM_TTL_HOURS=24
